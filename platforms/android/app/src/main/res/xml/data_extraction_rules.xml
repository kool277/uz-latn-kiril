<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: back up and transfer only the settings (DataStore); converted text is never stored. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
