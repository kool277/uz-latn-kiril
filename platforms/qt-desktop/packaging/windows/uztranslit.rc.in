// Windows resources of uztranslit.exe: icon and version information (configured by CMake).
#include <windows.h>

IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/packaging/windows/uztranslit.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "UzTranslit"
            VALUE "FileDescription", "UzTranslit - Uzbek script converter"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "uztranslit"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "uztranslit.exe"
            VALUE "ProductName", "UzTranslit"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
