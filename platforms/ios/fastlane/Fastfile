# fastlane for UzTranslit (iOS app + Share and Action extensions). From platforms/ios:
#   bundle install && bundle exec fastlane beta
#
# Environment (see README.md, "TestFlight"):
#   ASC_KEY_ID, ASC_ISSUER_ID  App Store Connect API key id and issuer id (App Manager or Admin role)
#   ASC_KEY_PATH               path to the AuthKey_<id>.p8 file, or
#   ASC_KEY_CONTENT            its contents (ASC_KEY_BASE64=true when base64-encoded, e.g. from a CI secret)
#   DEVELOPMENT_TEAM           Apple Developer team id (10 characters)
#   BUILD_NUMBER               optional; default: latest TestFlight build number + 1
require "base64"
require "shellwords"
require "tmpdir"

opt_out_usage # no fastlane usage metrics
default_platform(:ios)

APP_ID = "uz.jaybi.uztranslit"

platform :ios do
  desc "Generate the Xcode project, archive the app with automatic signing and upload it to TestFlight"
  lane :beta do
    key_id = ENV.fetch("ASC_KEY_ID") { UI.user_error!("Set ASC_KEY_ID") }
    issuer_id = ENV.fetch("ASC_ISSUER_ID") { UI.user_error!("Set ASC_ISSUER_ID") }
    team = ENV.fetch("DEVELOPMENT_TEAM") { UI.user_error!("Set DEVELOPMENT_TEAM to your Apple Developer team id") }
    key_path = ENV["ASC_KEY_PATH"]
    if key_path.nil? || key_path.empty?
      content = ENV.fetch("ASC_KEY_CONTENT") { UI.user_error!("Set ASC_KEY_PATH or ASC_KEY_CONTENT") }
      content = Base64.decode64(content) if ENV["ASC_KEY_BASE64"] == "true"
      key_path = File.join(Dir.mktmpdir("asc"), "AuthKey_#{key_id}.p8")
      File.write(key_path, content)
    end

    api_key = app_store_connect_api_key(key_id: key_id, issuer_id: issuer_id, key_filepath: key_path)

    # sh runs inside fastlane/; the actions below run in platforms/ios
    sh("cd .. && xcodegen generate")

    build_number = ENV["BUILD_NUMBER"]
    if build_number.nil? || build_number.empty?
      build_number = (latest_testflight_build_number(api_key: api_key, app_identifier: APP_ID, initial_build_number: 0) + 1).to_s
    end

    # xcodebuild signs automatically with the API key (cloud-managed certificates, profiles created as needed)
    auth = "-allowProvisioningUpdates -authenticationKeyPath #{key_path.shellescape} " \
           "-authenticationKeyID #{key_id} -authenticationKeyIssuerID #{issuer_id}"
    build_app(
      project: "UzTranslit.xcodeproj",
      scheme: "UzTranslit",
      configuration: "Release",
      clean: true,
      output_directory: "build",
      export_method: "app-store",
      export_team_id: team,
      export_options: { signingStyle: "automatic", teamID: team },
      xcargs: "DEVELOPMENT_TEAM=#{team} CURRENT_PROJECT_VERSION=#{build_number} #{auth}",
      export_xcargs: auth
    )

    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
