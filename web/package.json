{
  "name": "uztranslit-web",
  "version": "1.3.0",
  "scripts": {
    "ng": "ng",
    "sync": "node scripts/sync-core.mjs",
    "prestart": "npm run sync",
    "start": "ng serve",
    "prebuild": "npm run sync",
    "build": "ng build",
    "postbuild": "node scripts/seo.mjs && node scripts/csp-hash.mjs",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run sync",
    "test": "ng test --watch=false",
    "test:engine": "npm run sync && vitest run --config vitest.engine.config.ts",
    "e2e": "playwright test"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "^22.2.0",
    "fflate": "^0.8.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.0",
    "@playwright/test": "^1.64.1",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "description": "latin.jaybi.uz \u2014 Uzbek Cyrillic \u21c4 Latin 1995 \u21c4 Latin 2026 converter for text and documents (Angular + WebAssembly)",
